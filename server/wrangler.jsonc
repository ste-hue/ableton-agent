{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tembro-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "gettembro.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "LLM_ENDPOINT": "https://api.openai.com/v1/chat/completions",
    "LLM_MODEL": "gpt-5.6-luna",
    "SUBSCRIPTION_GRANT_CREDITS": "500",
    "CHAT_COST_CREDITS": "1",
    "BETA_GRANT_CREDITS": "100",
    "CHECKOUT_URL": "",
    "DOWNLOAD_URL": "https://github.com/ste-hue/ableton-agent/releases/download/v0.1.0-beta/Tembro-v0-mac.zip",
    "SUPPORT_EMAIL": ""
  },
  "observability": {
    "enabled": true
  }
}
